{
  "name": "Transferências Financeiras",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  "hostRequirements": {
    "cpus": 4,
    "memory": "8gb"
  },
  "forwardPorts": [15173, 15080],
  "portsAttributes": {
    "15173": { "label": "Frontend", "visibility": "public", "onAutoForward": "openBrowser" },
    "15080": { "label": "API e Swagger (/swagger)", "visibility": "public", "onAutoForward": "silent" }
  },
  "postStartCommand": "docker compose up -d --build --wait"
}
