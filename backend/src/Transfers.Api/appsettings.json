{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Transfers": ""
  },
  "RUN_SEEDS": false,
  "Database": {
    "ApplyMigrationsOnStartup": true
  },
  "TransferRules": {
    "TimeZone": "America/Sao_Paulo",
    "DaytimeStart": "06:00",
    "NighttimeStart": "22:00",
    "DefaultDaytimeLimit": {
      "MaxAmount": 5000,
      "MaxAttempts": 5
    },
    "DefaultNighttimeLimit": {
      "MaxAmount": 1000,
      "MaxAttempts": 3
    }
  },
  "Outbox": {
    "Enabled": true,
    "PollingIntervalMilliseconds": 1000,
    "BatchSize": 50,
    "MaxAttempts": 5
  },
  "ScheduledTransfers": {
    "Enabled": true,
    "PollingIntervalSeconds": 5,
    "BatchSize": 50
  }
}
